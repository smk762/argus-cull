# Copy to .env. Compose reads this file from the repo root.
# The page is on port 3000 and the curator on port 8101, on every interface.
# A change to NEXT_PUBLIC_CURATOR_URL needs `docker compose up --build`.

# Curator URL the browser calls. With a localhost value the host follows the
# page, so a page opened as this machine's LAN address calls that same address
# on port 8101. A value naming another machine is used as written. Baked at
# image build; a change needs `docker compose up --build`.
NEXT_PUBLIC_CURATOR_URL=http://localhost:8101

# Origins allowed to call the curator. Leave this empty to allow only
# http://localhost:3000 and http://127.0.0.1:3000. A set value replaces that
# list, so repeat those entries and add each http://<lan-address>:3000 the
# page will be opened as.
# CURATOR_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://203.0.113.10:3000

# Host port published for the curator. Keep it in step with the URL above.
CURATOR_PORT=8101

# Host directory mounted as the scan root. Inside the container this is /data/images.
CURATOR_SOURCE_PATH=./fixture

# Curated output root: the host directory exports land in. Inside the
# container this is /data/out. An export mirrors the source root's folders
# under it, so <source>/a/b/x.jpg goes to <output>/a/b/x.jpg. Its folder holds
# manifest.jsonl (lens, forge, proof read it), the CSV report, run_stats.json,
# and each image's .txt / .xmp / .json sidecars.
CURATED_OUTPUT_ROOT_PATH=./out

# Let Export move the kept files instead of copying them. Move takes each file
# and its sidecars out of the source folder, and cannot be undone from the page.
ALLOW_MOVE=0

# NudeNet 640m server the curator calls. The default is the nudenet service
# in this compose file. Set it empty to turn the check off.
ARGUS_CURATOR_NUDENET_URL=http://nudenet:8080

# Optional EraX-NSFW sidecar. When NudeNet returns no exposed score, curator
# maps EraX hits onto the same labels so filters and pairing still work.
# Set it empty to turn the second detector off.
ARGUS_CURATOR_ERAX_URL=http://erax:8080

# Watermark detector for the scan form's "Crop watermarks" check. It only runs
# when a scan asks for it. Empty makes such a scan fail with a 400.
ARGUS_CURATOR_WATERMARK_URL=http://watermark:8080

# SingGuard is agent-composer's /api/guard/check, the same guard darkroom
# uses. One model, one policy, the same verdicts. Empty turns the check off.
# A local in-process copy is `docker compose --profile local-singguard up`
# with ARGUS_CURATOR_SINGGUARD_URL=http://singguard:9150; do not run both.
# Set this to your composer host; it is empty (check off) until you do.
# ARGUS_CURATOR_SINGGUARD_URL=http://composer.example:9150
ARGUS_CURATOR_SINGGUARD_URL=
# fast: a verdict and rule, about a second a frame. fast-slow and slow also
# write why; slow has no fast verdict ahead of the reasoning. cascade (the
# default) is fast on every frame, then slow on the frames fast flags and
# on a MiVOLO age under 18 with an exposed NudeNet score of at least 0.2,
# and slow's verdict stands. A cascade pass that never needed slow comes
# back as thinking: fast.
ARGUS_CURATOR_SINGGUARD_THINKING=cascade
# What the scan already knows about a frame, sent to SingGuard as recorded
# context: age (each face's MiVOLO estimate), folder, caption (an argus-lens
# sidecar). Comma-separated; empty sends the image alone.
ARGUS_CURATOR_SINGGUARD_CONTEXT=age,folder,caption
# Only for --profile local-singguard: force one mode, and pin the Hub commit.
# SINGGUARD_FORCE_THINKING=
# SINGGUARD_REVISION=

# Lift the blur once NudeNet's exposed score is under this. A score at or
# above it stays blurred. An unsafe policy verdict puts the blur back.
# Set ARGUS_CULL_POLICY_BLUR=0 to opt out of that.
ARGUS_CULL_BLUR_EXPOSED_SCORE=0.25
ARGUS_CULL_POLICY_BLUR=1

# Host directory for SingGuard verdict labels, one JSON file per scanned
# folder. Download labels in the Policies panel writes the same rows as JSONL
# for argus-curator's scripts/guard_eval.py.
CULL_LABELS_PATH=./labels

# Setting and wardrobe cohort rules (Places365 categories and caption phrases)
# the page tags images with, to compare flag rates across styles. Edit the
# file and reload the page. Captions are read from argus-lens sidecars next to
# the images under CURATOR_SOURCE_PATH, which the web container mounts read-only.
CULL_COHORTS_PATH=./cohorts.json

# The curator takes turns on the GPU with argus-lens: one argus job at a time,
# each waiting for free VRAM. The lock file lives in this host directory, which
# lens must mount too. none turns the lease off.
# ARGUS_GPU_COORDINATOR=lease
# ARGUS_GPU_LOCK_DIR=/tmp/argus-gpu
# ARGUS_GPU_LEASE_TIMEOUT_S=300

# docker-compose.local-curator.yaml only: 1 builds the CUDA curator image,
# 0 the CPU one. CURATOR_CONTEXT is the curator checkout to build
# (default ../argus-curator).
# CURATOR_GPU=1
# CURATOR_CONTEXT=../argus-curator
