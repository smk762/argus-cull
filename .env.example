# Copy to .env. Compose reads this file from the repo root.
# The page is on port 3000 and the curator on port 8101, on every interface.
# A change to NEXT_PUBLIC_CURATOR_URL needs `docker compose up --build`.

# Curator URL the browser calls. With a localhost value the host follows the
# page, so a page opened as this machine's LAN address calls that same address
# on port 8101. A value naming another machine is used as written. Baked at
# image build; a change needs `docker compose up --build`.
NEXT_PUBLIC_CURATOR_URL=http://localhost:8101

# Origins allowed to call the curator. Leave this empty to allow only
# http://localhost:3000 and http://127.0.0.1:3000. A set value replaces that
# list, so repeat those entries and add each http://<lan-address>:3000 the
# page will be opened as.
# CURATOR_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://192.168.1.10:3000

# Host port published for the curator. Keep it in step with the URL above.
CURATOR_PORT=8101

# Host directory mounted as the scan root. Inside the container this is /data/images.
CURATOR_SOURCE_PATH=./fixture

# Host directory mounted as the export root. Inside the container this is /data/out.
CURATOR_OUTPUT_PATH=./out

# NudeNet server the curator calls. The default is the nudenet service in this
# compose file. Set it empty to turn the check off.
ARGUS_CURATOR_NUDENET_URL=http://nudenet:8080

# SingGuard server the curator calls. The default is the singguard service in
# this compose file (inclusionAI/Sing-Guard-4b, NVIDIA GPU, first start
# downloads the weights). Set it empty to turn the check off.
# fast-slow also writes why a rule fired.
ARGUS_CURATOR_SINGGUARD_URL=http://singguard:9150
ARGUS_CURATOR_SINGGUARD_THINKING=fast
# The singguard service's own modes, which curator 0.5 cannot ask for: slow
# (reasoning with no fast verdict ahead of it) and cascade (fast for every
# frame, about a second, then slow for the frames fast flags; slow's verdict
# stands). Set to judge every request in that mode. See README.
# SINGGUARD_FORCE_THINKING=cascade

# Hugging Face commit sha for the SingGuard weights. The model loads with
# trust_remote_code, so pinning this also pins the code that runs.
# SINGGUARD_REVISION=

# Lift the blur once NudeNet's exposed score is under this. A score at or
# above it stays blurred. An unsafe policy verdict puts the blur back.
# Set ARGUS_CULL_POLICY_BLUR=0 to opt out of that.
ARGUS_CULL_BLUR_EXPOSED_SCORE=0.25
ARGUS_CULL_POLICY_BLUR=1

# Host directory for SingGuard verdict labels, one JSON file per scanned
# folder. Download labels in the Policies panel writes the same rows as JSONL
# for argus-curator's scripts/guard_eval.py.
CULL_LABELS_PATH=./labels

# Setting and wardrobe cohort rules (Places365 categories and caption phrases)
# the page tags images with, to compare flag rates across styles. Edit the
# file and reload the page. Captions are read from argus-lens sidecars next to
# the images under CURATOR_SOURCE_PATH, which the web container mounts read-only.
CULL_COHORTS_PATH=./cohorts.json
